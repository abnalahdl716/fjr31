@echo off
chcp 65001 > nul
title نظام حضور وانصراف مؤسسة الفجر الخيرية الاجتماعية
color 0A

echo ======================================================================
echo       نظام حضور وانصراف وإجازات مؤسسة الفجر الخيرية الاجتماعية
echo ======================================================================
echo.

where node >nul 2>nul
if %errorlevel% neq 0 (
    color 0C
    echo [تنبيه هام] برنامج Node.js غير مثبت على جهازك!
    echo.
    echo لتشغيل تطبيقات الويب الحديثة المبنية بـ (React / Vite) محليا:
    echo تحتاج إلى تثبيت برنامج Node.js لمرة واحدة فقط (مجاني تماما).
    echo.
    echo رابط التحميل المباشر:
    echo https://nodejs.org
    echo.
    echo قم بتحميل الإصدار الموصى به (LTS) وتثبيته، ثم اضغط على هذا الملف مجددا.
    echo ======================================================================
    pause
    exit /b
)

if not exist node_modules (
    echo [1/2] جاري تثبيت حزم ومكتبات المشروع لأول مرة (يرجى الانتظار دقيقة واحدة)...
    call npm install
    if %errorlevel% neq 0 (
        color 0C
        echo حدث خطأ أثناء تثبيت المكتبات. يرجى التأكد من اتصال الإنترنت.
        pause
        exit /b
    )
)

echo.
echo [2/2] جاري تشغيل الخادم المحلي للموقع...
echo.
echo سيتم فتح الموقع تلقائيا في المتصفح على الرابط:
echo http://localhost:3000
echo.
echo (لإيقاف تشغيل الموقع، يمكنك إغلاق هذه النافذة في أي وقت)
echo ======================================================================
echo.

start "" "http://localhost:3000"
call npm run dev

pause
