@echo off
chcp 65001 > nul
title تشغيل نظام حضور وانصراف مؤسسة الفجر الخيرية الاجتماعية
color 0A

echo ======================================================================
echo       نظام حضور وانصراف وإجازات مؤسسة الفجر الخيرية الاجتماعية
echo ======================================================================
echo.

:: 1. إذا كان مجلد dist الجاهز موجوداً ولا يوجد node، نقوم بفتحه فوراً
where node >nul 2>nul
if %errorlevel% neq 0 (
    if exist "dist\index.html" (
        echo [معلومة] تم العثور على النسخة المدمجة الجاهزة من الموقع!
        echo جاري تشغيل الموقع مباشرة في متصفحك...
        start "" "dist\index.html"
        exit /b
    )
    color 0C
    echo [تنبيه هام] برنامج Node.js غير مثبت على جهازك!
    echo.
    echo لتشغيل وضع التطوير المحلي:
    echo تحتاج إلى تثبيت برنامج Node.js لمرة واحدة فقط (مجاني تماماً).
    echo رابط التحميل المباشر: https://nodejs.org (نسخة LTS)
    echo.
    echo أو يمكنك فتح ملف "dist\index.html" مباشرة في أي متصفح!
    echo ======================================================================
    pause
    exit /b
)

if not exist node_modules (
    echo [1/2] جاري تثبيت حزم ومكتبات المشروع (يرجى الانتظار دقيقة واحدة)...
    call npm install
    if %errorlevel% neq 0 (
        if exist "dist\index.html" (
            echo تعذر تثبيت الحزم، سيتم تشغيل النسخة الجاهزة مباشرة...
            start "" "dist\index.html"
            exit /b
        )
        color 0C
        echo حدث خطأ أثناء تثبيت المكتبات. يرجى التأكد من اتصال الإنترنت.
        pause
        exit /b
    )
)

echo.
echo [2/2] جاري تشغيل الخادم المحلي للموقع...
echo سيتم فتح الموقع تلقائياً في المتصفح على الرابط: http://localhost:3000
echo ======================================================================
echo.

start "" "http://localhost:3000"
call npm run dev

pause
